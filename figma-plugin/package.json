{
  "name": "fragmento-figma-plugin",
  "version": "1.0.0",
  "description": "Fragmento Design Token Management Plugin for Figma",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "npm run build:plugin && npm run build:ui",
    "build:plugin": "esbuild src/plugin/plugin.ts --bundle --outfile=dist/plugin.js --target=es2017",
    "build:ui": "cp src/ui/vanilla.js dist/vanilla.js && esbuild src/ui/styles.css --bundle --outfile=dist/ui.css",
    "watch": "npm run watch:plugin & npm run watch:ui",
    "watch:plugin": "npm run build:plugin -- --watch",
    "watch:ui": "npm run build:ui -- --watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.90.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
